{
self,
inputs,
moduleWithSystem,
...
}: {
  flake.nixosModules.hyprland = moduleWithSystem ({ 
    pkgs, 
    inputs',
    self',
    ... 
  }: {
    programs.hyprland = {
      enable = true;
      package = self.packages.${pkgs.stdenv.hostPlatform.system}.myHypr;
    };
  )};


  perSystem = { pkgs, lib, self', ... }: {
    packages.myHypr = inputs'. {
      inherit pkgs;
      settings = {

      };
    };
  };
}
